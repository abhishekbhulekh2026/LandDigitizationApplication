                <i class="bi bi-person-circle"></i>
                <strong>User :</strong>
                <span id="lblStatusUser">Administrator</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-file-earmark-text"></i>
                <strong>Page :</strong>
                <span id="lblStatusPage">15 / 250</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-table"></i>
                <strong>Records :</strong>
                <span id="lblRecordCount">18</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-cloud-check text-success"></i>
                <strong>Status :</strong>
                <span id="lblSaveStatus" class="text-success">
                    Ready
                </span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-search"></i>
                <strong>Zoom :</strong>
                <span>100%</span>
            </div>

