@page


@{
    ViewData["Title"] = "Record Entry";
    Layout = "_Layout";
}

@section Styles {

    <link href="~/css/record-entry.css" rel="stylesheet" />

}

<div class="record-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

       <div class="record-header shadow-sm">

        <div class="row align-items-center">

            <div class="col-lg-4">

                <div class="d-flex align-items-center">

                    <div class="logo-circle">
                        <i class="bi bi-bank2"></i>
                    </div>

                    <div class="ms-3">

                        <h3 class="portal-title mb-0">
                            Lucknow Bhulekh
                        </h3>

                        <small class="text-muted">
                            Land Digitization Portal
                        </small>

                    </div>

                </div>

            </div>

            <div class="col-lg-4 text-center">

                <h5 class="record-title">
                    Record Entry Workspace
                </h5>

            </div>

            <div class="col-lg-4 text-end">

                <strong>Welcome,</strong>
                <span id="lblUser">Administrator</span>

                <br />

                <small id="lblCurrentDate"></small>

            </div>

        </div>

    </div>
        <!-- ========================================================= -->
        <!-- BREADCRUMB -->
        <!-- ========================================================= -->

        <div class="record-breadcrumb shadow-sm">

            <nav aria-label="breadcrumb">

                <ol class="breadcrumb mb-0">

                    <li class="breadcrumb-item">
                        <a href="/Index">Dashboard</a>
                    </li>

                    <li class="breadcrumb-item">
                        Record Entry
                    </li>

                    <li class="breadcrumb-item active">
                        CH Form 41 / 45
                    </li>

                </ol>

            </nav>

        </div>
    </div>



    <!-- ========================================================= -->
    <!-- INFORMATION PANEL -->
    <!-- ========================================================= -->

    <div class="record-information shadow-sm">

        <div class="row">

            <div class="col-lg-2">

                <label class="form-label">

                    District

                </label>

                <select class="form-select" id="ddlDistrict">

                    <option>

                        Lucknow

                    </option>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label">

                    Tehsil

                </label>

                <select class="form-select" id="ddlTehsil">

                    <option>

                        Bakshi Ka Talab

                    </option>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label">

                    Village

                </label>

                <select class="form-select" id="ddlVillage">

                    <option>

                        Select Village

                    </option>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label">

                    Record Type

                </label>

                <select class="form-select" id="ddlRecordType">

                    <option>

                        CH Form 41/45

                    </option>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label">

                    Volume

                </label>

                <select class="form-select" id="ddlVolume">

                    <option>

                        Volume 01

                    </option>

                </select>

            </div>

            <div class="col-lg-2">

                <label class="form-label">

                    Page

                </label>

                <select class="form-select" id="ddlPage">

                    <option>

                        Page 1

                    </option>

                </select>

            </div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <div class="record-toolbar shadow-sm">

        <div class="btn-toolbar">

            <div class="btn-group me-2">

                <button class="btn btn-primary">

                    <i class="bi bi-house"></i>

                    Dashboard

                </button>

            </div>

            <div class="btn-group me-2">

                <button class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left-circle"></i>

                    Previous

                </button>

                <button class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-right-circle"></i>

                    Next

                </button>

            </div>

            <div class="btn-group me-2">

                <button class="btn btn-outline-primary">

                    <i class="bi bi-search"></i>

                    Search

                </button>

            </div>

            <div class="btn-group me-2">

            <button class="btn btn-success" id="btnSave">

                    <i class="bi bi-floppy"></i>

                    Save

                </button>

            <button id="btnSaveNext" class="btn btn-success">

                    <i class="bi bi-check-circle"></i>

                    Save & Next

                </button>

            </div>

            <div class="btn-group me-2">

            <button id="btnRefresh" class="btn btn-outline-dark">

                    <i class="bi bi-arrow-repeat"></i>

                    Refresh

                </button>

            </div>

            <div class="btn-group ms-auto">

                <button class="btn btn-outline-danger">

                    <i class="bi bi-box-arrow-right"></i>

                    Exit

                </button>

            </div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- MAIN CONTENT START -->
    <!-- ========================================================= -->

    <div class="record-body">

        <div class="row g-3">

            <!-- LEFT PANEL START -->

            <div class="col-lg-5">
          @*   <iframe src="assets/dummy.pdf" width="100%" height="100%" style="border:none; min-height:650px; flex-grow:1; display:block;" title="Land Record PDF Preview"></iframe> *@
                <!-- PDF Panel continues in Part 1B -->
                <!-- ========================================================= -->
                <!-- LEFT PANEL : PDF VIEWER -->
                <!-- ========================================================= -->

                <div class="record-panel shadow-sm h-100">

                    <div class="panel-header d-flex justify-content-between align-items-center">

                        <div>
                            <i class="bi bi-file-earmark-pdf text-danger"></i>
                            <strong>Scanned Record</strong>
                        </div>

                        <div class="btn-group btn-group-sm">

                            <button class="btn btn-light">
                                <i class="bi bi-zoom-out"></i>
                            </button>

                            <button class="btn btn-light">
                                100%
                            </button>

                            <button class="btn btn-light">
                                <i class="bi bi-zoom-in"></i>
                            </button>

                            <button class="btn btn-light">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>

                        </div>

                    </div>

                    <div class="pdf-toolbar">

                        <button class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </button>

                        <span class="mx-3">
                            Page <strong>15</strong> of <strong>250</strong>
                        </span>

                        <button class="btn btn-outline-secondary btn-sm">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </button>

                    </div>

                    <div class="pdf-viewer">

                        <div class="pdf-placeholder">

                            <i class="bi bi-file-earmark-pdf-fill"></i>

                            <h5 class="mt-3">

                                PDF Viewer

                            </h5>

                            <p>

                                Scanned page will appear here.

                            </p>

                        </div>

                    </div>

                </div>
            </div>

            <!-- RIGHT PANEL START -->

            <div class="col-lg-7">

                <!-- Entry Grid continues in Part 1B -->
                <!-- ========================================================= -->
                <!-- RIGHT PANEL : ENTRY GRID -->
                <!-- ========================================================= -->

                <div class="record-panel shadow-sm h-100">

                    <div class="panel-header d-flex justify-content-between align-items-center">

                        <div>

                            <i class="bi bi-table"></i>

                            <strong>

                                CH Form 41 / 45 Entry

                            </strong>

                        </div>

                        <div>

                            <button class="btn btn-primary btn-sm">

                                <i class="bi bi-plus-circle"></i>

                                Add Row

                            </button>

                            <button class="btn btn-outline-danger btn-sm">

                                <i class="bi bi-trash"></i>

                                Delete

                            </button>

                        </div>

                    </div>


                    <div class="grid-summary">

                        <div class="row text-center">

                            <div class="col">

                                <div class="summary-box">

                                    <div class="summary-title">

                                        Total Records

                                    </div>

                                    <div class="summary-value">

                                        18

                                    </div>

                                </div>

                            </div>

                            <div class="col">

                                <div class="summary-box">

                                    <div class="summary-title">

                                        Completed

                                    </div>

                                    <div class="summary-value text-success">

                                        12

                                    </div>

                                </div>

                            </div>

                            <div class="col">

                                <div class="summary-box">

                                    <div class="summary-title">

                                        Pending

                                    </div>

                                    <div class="summary-value text-danger">

                                        6

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="table-responsive mt-3">

                        <table class="table table-bordered table-hover align-middle">

                            <thead class="table-primary">

                                <tr>

                                    <th style="width:70px">Sr.</th>

                                    <th>New Khata</th>

                                    <th>New Area</th>

                                    <th>Old Gata</th>

                                    <th>Old Area</th>

                                    <th>Soil Class</th>

                                    <th>Land Type</th>

                                    <th>Remark</th>

                                </tr>

                            </thead>

                            <tbody>

                                <tr>

                                    <td>1</td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                </tr>

                                <tr>

                                    <td>2</td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                    <td><input class="form-control" /></td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>
            </div>

        </div>

    </div>
    <!-- ========================================================= -->
    <!-- STATUS BAR -->
    <!-- ========================================================= -->

    <div class="record-statusbar shadow-sm">

        <div class="row align-items-center">

            <div class="col-md-2">
                <i class="bi bi-person-circle"></i>
                <strong>User :</strong>
                <span id="lblStatusUser">Administrator</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-file-earmark-text"></i>
                <strong>Page :</strong>
                <span id="lblStatusPage">15 / 250</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-table"></i>
                <strong>Records :</strong>
                <span id="lblRecordCount">18</span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-cloud-check text-success"></i>
                <strong>Status :</strong>
                <span id="lblSaveStatus" class="text-success">
                    Ready
                </span>
            </div>

            <div class="col-md-2">
                <i class="bi bi-search"></i>
                <strong>Zoom :</strong>
                <span>100%</span>
            </div>

            <div class="col-md-2 text-end">

                <span id="lblClock">

                    @DateTime.Now.ToString("dd MMM yyyy HH:mm")

                </span>

            </div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- TOAST NOTIFICATION -->
    <!-- ========================================================= -->

    <div class="toast-container position-fixed bottom-0 end-0 p-3">

        <div id="appToast"
             class="toast"
             role="alert">

            <div class="toast-header">

                <i class="bi bi-info-circle-fill text-primary me-2"></i>

                <strong class="me-auto">

                    Notification

                </strong>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast">
                </button>

            </div>

            <div class="toast-body">

                Welcome to Record Entry Screen.

            </div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- GLOBAL LOADER -->
    <!-- ========================================================= -->

    <div id="pageLoader" class="loader-overlay" style="display:none">

        <div class="text-center">

            <div class="spinner-border text-primary"
                 style="width:4rem;height:4rem;">
            </div>

            <div class="mt-3">

                Please wait...

            </div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- KEYBOARD SHORTCUTS MODAL -->
    <!-- ========================================================= -->

    <div class="modal fade"
         id="keyboardModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">

                        Keyboard Shortcuts

                    </h5>

                    <button class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <table class="table table-bordered">

                        <thead class="table-light">

                            <tr>

                                <th>Shortcut</th>

                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>Ctrl + S</td>
                                <td>Save Record</td>
                            </tr>

                            <tr>
                                <td>Ctrl + Enter</td>
                                <td>Save & Next Page</td>
                            </tr>

                            <tr>
                                <td>F2</td>
                                <td>Edit Current Cell</td>
                            </tr>

                            <tr>
                                <td>F3</td>
                                <td>Search Record</td>
                            </tr>

                            <tr>
                                <td>F5</td>
                                <td>Refresh Screen</td>
                            </tr>

                            <tr>
                                <td>Esc</td>
                                <td>Close Dialog</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-primary"
                            data-bs-dismiss="modal">

                        Close

                    </button>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script src="~/js/common/pdfviewer.js"></script>

    <script src="~/js/common/editable-grid.js"></script>

    <script src="~/js/recordentry/record-entry.js"></script>

    <script src="~/js/common/keyboard.js"></script>

    <script src="~/js/common/page.js"></script>

    <script src="~/js/common/validator.js"></script>

    <script src="~/js/common/toolbar.js"></script>

    <script src="~/js/common/statusbar.js"></script>
}