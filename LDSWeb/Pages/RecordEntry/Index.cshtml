                    </h6>

                    <div class="mb-4">
                        <textarea id="officerComments" class="form-control p-3" rows="3" placeholder="रिकॉर्ड रूम लॉग के लिए टिप्पणियाँ लिखें..." required></textarea>
                        <div class="form-text text-muted small mt-1"><i class="bi bi-eye-fill me-1"></i>ये टिप्पणियां ऑडिट लॉग में दिखाई देंगी।</div>
                    </div>

                    <div class="alert alert-warning-custom d-flex align-items-center justify-content-between p-3 rounded-3 mb-0 flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-2 small">
                            <i class="bi bi-info-circle-fill"></i>
                            <span class="fw-semibold">यह कार्रवाई ऑडिट लॉग में दर्ज की जाएगी। (This action will be recorded in the audit log)</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button id="btnApprove" class="btn approve-btn text-white px-4 py-2.5 d-flex align-items-center gap-2 fw-bold rounded-3">
                                <i class="bi bi-check-circle-fill"></i> मंजूरी दीजिये (Approve)
                            </button>
                            <button id="btnReject" class="btn reject-btn text-white px-4 py-2.5 d-flex align-items-center gap-2 fw-bold rounded-3">
                                <i class="bi bi-x-circle-fill"></i> अस्वीकार (Reject)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="appToast" class="toast align-items-center text-white border-0" style="background:var(--navy);" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMsg">Action completed.</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

   
    <script>
        document.addEventListener('DOMContentLoaded', function() {
        var commentsArea = document.getElementById('officerComments');
        var btnApprove = document.getElementById('btnApprove');
        var btnReject = document.getElementById('btnReject');

        function handleAction(status) {
        var comments = commentsArea.value.trim();
        if (!comments) {
        commentsArea.classList.add('is-invalid');
        showToast('कृपया पहले अधिकारी टिप्पणियाँ (टिप्पणी) दर्ज करें। (Please enter officer comments first)');
        commentsArea.focus();
        return;
        }

        commentsArea.classList.remove('is-invalid');
        commentsArea.disabled = true;
        btnApprove.disabled = true;
        btnReject.disabled = true;

        var toastMessage = status === 'Approved'
        ? 'आवेदन सफलतापूर्वक स्वीकृत कर लिया गया है। (Application approved successfully.)'
        : 'आवेदन अस्वीकार कर दिया गया है। (Application rejected successfully.)';

        showToast(toastMessage);
        }

        if (btnApprove && btnReject && commentsArea) {
        btnApprove.addEventListener('click', function() {
        handleAction('Approved');
        });

        btnReject.addEventListener('click', function() {
        handleAction('Rejected');
        });

        commentsArea.addEventListener('input', function() {
        if (this.value.trim()) {
        this.classList.remove('is-invalid');
        }
        });
        }
        });
    </script>

