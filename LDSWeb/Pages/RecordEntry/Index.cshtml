    <style>
            .alert-warning-custom {
                background-color: #fff9e6;
                border: 1px solid #ffeeba;
                color: #856404;
            }

                .alert-warning-custom i {
                    color: var(--saffron);
                    font-size: 1.1rem;
                }

            .review-icon-wrap {
                width: 54px;
                height: 54px;
                border-radius: 12px;
                background-color: rgba(13, 79, 139, 0.08);
                color: var(--navy);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
                flex-shrink: 0;
            }

            .detail-label {
                font-weight: 600;
                color: var(--muted);
                font-size: 0.8rem;
            }

            .detail-value {
                color: var(--text);
                font-size: 0.9rem;
            }

            .pdf-container {
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
                background-color: #1e1e24;
                box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
            }

            .back-link {
                color: var(--navy);
                font-weight: 600;
                font-size: 0.88rem;
                transition: color 0.15s ease;
            }

                .back-link:hover {
                    color: var(--saffron);
                }
    </style>

    <!-- Bootstrap (if using Bootstrap) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

   
</head>
