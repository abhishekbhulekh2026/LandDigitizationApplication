@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | Lucknow Bhulekh Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">

    <!-- Bootstrap (if using Bootstrap) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/js/api.js"></script>
    <style>
        .loader-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.6);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 99999;
        }

        .loader-overlay img {
        width: 80px;
        height: 80px;
        object-fit: contain;
        }
    </style>
</head>
<body class="auth-page-body">

    <div class="utility-strip">
        <span><i class="bi bi-translate"></i> Government of Uttar Pradesh</span>
        <div class="d-flex align-items-center">
            <a href="#"><i class="bi bi-arrow-right-circle"></i> Skip to Main Content</a>
            <select><option>English</option><option>हिन्दी</option></select>
        </div>
    </div>

    <div class="nic-header-main px-5">
        <div class="masthead-office">
            <img src="~/assets/up-seal.svg" alt="Seal of Uttar Pradesh">
            <h4>
                <a href="https://lucknow.nic.in/" target="_blank">ज़िलाधिकारी कार्यालय, लखनऊ</a><br>
                <span><a href="https://lucknow.nic.in/" target="_blank">DISTRICT MAGISTRATE OFFICE, LUCKNOW</a></span>
            </h4>
        </div>
        <div class="campaign-banner-wrap">
            <div class="campaign-banner-placeholder">
                <i class="bi bi-flag-fill" style="color:#f5821f; font-size:1.3rem;"></i>
                Azadi Ka Amrit Mahotsav<br>"Har Ghar Tiranga" Campaign
            </div>
        </div>
        <a class="nic-logo-link" href="https://www.nic.gov.in/" target="_blank">
            <img src="~/assets/nic-logo.svg" alt="National Informatics Centre">
        </a>
    </div>

    <div class="subnav">
        <div class="subnav-links">
            <a href="#"><i class="bi bi-envelope"></i> Contact</a>
            <a href="#"><i class="bi bi-headset"></i> Support</a>
        </div>
        <div class="user-meta small text-muted">
            <i class="bi bi-shield-lock-fill"></i> Secure Officer Access
        </div>
    </div>
   

    <div class="auth-wrap">
      
        <div id="loading" class="loader-overlay" style="display:none;">
            <img src="~/loader.gif" alt="Loading">
        </div>

        <div class="auth-card">
            <div class="auth-side">
                <div>
                    <div class="auth-glass-icon"><i class="bi bi-bank2"></i></div>
                    <h2>Lucknow Bhulekh</h2>
                    <p class="lead-text">Digital Land Record Portal of the District Magistrate Office, Lucknow. Sign in to manage citizen accounts and process record applications.</p>
                    <div class="feature-row"><i class="bi bi-map"></i><span>Track khasra-wise land parcels across all tehsils</span></div>
                    <div class="feature-row"><i class="bi bi-patch-check"></i><span>Issue digitally verified, tamper-proof record copies</span></div>
                    <div class="feature-row"><i class="bi bi-shield-lock"></i><span>Role-based secure access for officers and admins</span></div>
                </div>
                <p class="auth-footnote">Developed &amp; maintained by National Informatics Centre (NIC), Lucknow</p>
            </div>
            <div class="auth-form-pane">
               
                <h4 class="mb-1">Officer Login</h4>
                <p class="text-muted small mb-4">Enter your credentials to access the admin dashboard</p>
                <form id="loginForm">
                    <div class="mb-3">
                        <label class="form-label">Employee ID / Email</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-envelope"></i>
                            <input type="text" class="form-control" placeholder="officer@lucknow.nic.in" required id="txtUserName">
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Password</label>
                        <div class="input-icon-wrap">
                            <i class="bi bi-lock"></i>
                            <input type="password" class="form-control" placeholder="Enter your password" required id="txtPassword">
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label small text-muted" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="small auth-toggle-link">Forgot password?</a>
                    </div>
                    <button type="button" class="btn btn-saffron w-100 mb-3" id="btnLogin">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                    <p class="text-center small text-muted mb-0">
                        Don't have an account? <a href="~/Register" class="auth-toggle-link">Create one</a>
                    </p>
                </form>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container text-center">
            <div class="footer-links">
                <a href="#">Website Policies</a>
                <span class="text-muted">|</span>
                <a href="#">Help</a>
                <span class="text-muted">|</span>
                <a href="#">Contact Us</a>
                <span class="text-muted">|</span>
                <a href="#">Terms & Conditions</a>
            </div>
            <div class="footer-credits">
                <p class="mb-1">© District Administration Lucknow, Developed and hosted by <strong>National Informatics Centre (NIC)</strong>,</p>
                <p class="mb-0">Ministry of Electronics & Information Technology, Government of India.</p>
                <p class="small text-muted mt-2">Last Updated: Jun 29, 2026</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/main.js"></script>

    <script src="~/js/login.js"></script>

    <script src="~/js/loader.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/notification.js"></script>
</body>
</html>

