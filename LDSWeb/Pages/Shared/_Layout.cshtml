
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Lucknow Bhulekh Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    <!-- jQuery -->
   

    <!-- Bootstrap (if using Bootstrap) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


</head>
<body>

    <div class="utility-strip">
        <span><i class="bi bi-translate"></i> Government of Uttar Pradesh</span>
        <div class="d-flex align-items-center">
            <a href="#"><i class="bi bi-arrow-right-circle"></i> Skip to Main Content</a>
            <select><option>English</option><option>हिन्दी</option></select>
        </div>
    </div>

    <div class="nic-header-main px-5">
        <div class="masthead-office">
            <img src="~/assets/up-seal.svg" alt="Seal of Uttar Pradesh">
            <h4>
                <a href="https://lucknow.nic.in/" target="_blank">ज़िलाधिकारी कार्यालय, लखनऊ</a><br>
                <span><a href="https://lucknow.nic.in/" target="_blank">DISTRICT MAGISTRATE OFFICE, LUCKNOW</a></span>
            </h4>
        </div>
        <div class="campaign-banner-wrap">
            <div class="campaign-banner-placeholder">
                <i class="bi bi-flag-fill" style="color:#f5821f; font-size:1.3rem;"></i>
                Azadi Ka Amrit Mahotsav<br>"Har Ghar Tiranga" Campaign
            </div>
        </div>
        <a class="nic-logo-link" href="https://www.nic.gov.in/" target="_blank">
            <img src="~/assets/nic-logo.svg" alt="National Informatics Centre">
        </a>
    </div>

    <div class="subnav">
        <div class="subnav-links">
            <a href="#"><i class="bi bi-envelope"></i> Contact</a>
            <a href="dashboard.html" class="active"><i class="bi bi-grid-1x2"></i> Dashboard</a>
            <a href="#"><i class="bi bi-headset"></i> Support</a>
        </div>
        <div class="dropdown user-meta">
            <a href="#" class="dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle"></i> Logged in as: <b>Amit Verma</b> (OFFICER)
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="profile.html">My Profile</a></li>
                <li><a class="dropdown-item js-logout" href="#">Logout</a></li>
            </ul>
        </div>
    </div>

    <div class="app-layout">
        <div class="sidebar">
            <div class="sidebar-brand">
                <div class="emblem"><i class="bi bi-bank2"></i></div>
                <div>
                    <p class="brand-title">Lucknow Bhulekh</p>
                    <p class="brand-sub">Government of Uttar Pradesh</p>
                </div>
            </div>
            <nav class="sidebar-nav">
                <a href="~/Index" class="active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                <a href="profile.html" class=""><i class="bi bi-person-circle"></i> My Profile</a>
                <a href="create-user.html" class=""><i class="bi bi-person-plus-fill"></i> Create User</a>
                <a href="user-list.html" class=""><i class="bi bi-people-fill"></i> View User List</a>
                <a href="approve-reject.html" class=""><i class="bi bi-clipboard-check-fill"></i> Approve / Reject</a>
                <a href="data-entry.html" class=""><i class="bi bi-pencil-square"></i> Data Entry</a>
            </nav>
            <div class="sidebar-foot">
                <a href="javascript:void(0)" id="btnLogout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>
        <div class="main-content">
                @RenderBody()
        </div>
    </div>

        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="appToast" class="toast align-items-center text-white border-0" style="background:var(--navy);" role="alert">
                <div class="d-flex">
                    <div class="toast-body" id="toastMsg">Action completed.</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>

        <footer class="site-footer">
            <div class="container text-center">
                <div class="footer-links">
                    <a href="#">Website Policies</a>
                    <span class="text-muted">|</span>
                    <a href="#">Help</a>
                    <span class="text-muted">|</span>
                    <a href="#">Contact Us</a>
                    <span class="text-muted">|</span>
                    <a href="#">Terms & Conditions</a>
                </div>
                <div class="footer-credits">
                    <p class="mb-1">© District Administration Lucknow, Developed and hosted by <strong>National Informatics Centre (NIC)</strong>,</p>
                    <p class="mb-0">Ministry of Electronics & Information Technology, Government of India.</p>
                    <p class="small text-muted mt-2">Last Updated: Jun 29, 2026</p>
                </div>
            </div>
        </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/main.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/js/api.js"></script>

    <script src="~/js/logout.js"></script>


    <script>
        if (!localStorage.getItem("jwtToken")) {
        window.location.replace("/Login");
        }
    </script>

    @RenderSection("Scripts", required: false)

    </body>
</html>
