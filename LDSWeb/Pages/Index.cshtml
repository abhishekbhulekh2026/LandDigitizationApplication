@page
@{

    <div class="page-head">
        <div class="user-block">
            <div class="avatar-circle">AV</div>
            <div>
                <h5>Welcome back, Amit Verma</h5>
                <p>Here's what's happening with land record applications today</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <div class="icon-btn"><i class="bi bi-bell"></i></div>
            <div class="icon-btn"><i class="bi bi-gear"></i></div>
        </div>
    </div>

    <div class="page-title">Dashboard</div>
    <div class="page-sub">Overview of citizen accounts and record applications</div>

    <div class="row g-3 mb-3">
        <div class="col-md-3 col-sm-6">
            <div class="stat-tile tile-lightblue">
                <i class="bi bi-folder-fill stat-icon"></i>
                <div class="stat-num">18</div>
                <div class="stat-label">Draft Applications</div>
                <div class="stat-label">Draft Applications</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-tile tile-green">
                <i class="bi bi-check-circle-fill stat-icon"></i>
                <div class="stat-num">0</div>
                <div class="stat-label">Approved (Pending DSC)</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-tile tile-orange">
                <i class="bi bi-hourglass-split stat-icon"></i>
                <div class="stat-num">238</div>
                <div class="stat-label">Submitted (Pending Approval)</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-tile tile-purple">
                <i class="bi bi-patch-check-fill stat-icon"></i>
                <div class="stat-num">9,914</div>
                <div class="stat-label">Certified Copies Delivered</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="stat-tile tile-blue">
                <i class="bi bi-graph-up stat-icon"></i>
                <div class="stat-num">14</div>
                <div class="stat-label">Pages Applied Today (Pages applied in Application)</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="stat-tile tile-green">
                <i class="bi bi-file-earmark-text-fill stat-icon"></i>
                <div class="stat-num">50</div>
                <div class="stat-label">Pages Remaining Today (Can be applied today)</div>

                @* <input type="text" id="txtUserName" placeholder="Username">

                // <input type="password" id="txtPassword" placeholder="Password">

                // <button id="btnLogin">Login</button> *@
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card-block">
                <div class="card-block-header">
                    <h6>Recent Applications</h6>
                    <a href="approve-reject.html" class="small auth-toggle-link">View all</a>
                </div>
                <div class="card-block-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Application No.</th><th>Applicant</th><th>Khasra No.</th><th>Date</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr><td>LKO/2026/04821</td><td>Ramesh Yadav</td><td>112/3</td><td>18 Jun 2026</td><td><span class="badge-status badge-pending">Pending</span></td></tr>
                                <tr><td>LKO/2026/04820</td><td>Sunita Devi</td><td>87/1</td><td>18 Jun 2026</td><td><span class="badge-status badge-approved">Approved</span></td></tr>
                                <tr><td>LKO/2026/04819</td><td>Arvind Kumar</td><td>45/2</td><td>17 Jun 2026</td><td><span class="badge-status badge-rejected">Rejected</span></td></tr>
                                <tr><td>LKO/2026/04818</td><td>Pooja Sharma</td><td>203/5</td><td>17 Jun 2026</td><td><span class="badge-status badge-pending">Pending</span></td></tr>
                                <tr><td>LKO/2026/04817</td><td>Manoj Tiwari</td><td>9/1</td><td>16 Jun 2026</td><td><span class="badge-status badge-approved">Approved</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-block h-100">
                <div class="card-block-header"><h6>Quick Actions</h6></div>
                <div class="card-block-body d-flex flex-column gap-2">
                    <a href="create-user.html" class="btn btn-saffron text-start"><i class="bi bi-person-plus-fill me-2"></i>Create New User</a>
                    <a href="user-list.html" class="btn btn-outline-navy text-start"><i class="bi bi-people-fill me-2"></i>View All Users</a>
                    <a href="approve-reject.html" class="btn btn-outline-navy text-start"><i class="bi bi-clipboard-check-fill me-2"></i>Review Applications</a>
                    <hr style="border-color:var(--border); margin:20px 0;">
                    <p class="small text-muted mb-1"><i class="bi bi-info-circle me-1"></i>Maximum 5 khasra numbers per application, up to 50 pages.</p>
                    <p class="small text-muted mb-0"><i class="bi bi-shield-check me-1"></i>All certified copies carry a digital signature.</p>
                </div>
            </div>
        </div>
    </div>

}
@* @section Scripts {
    <script src="~/js/auth.js"></script>
} *@